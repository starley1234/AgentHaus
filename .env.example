# ═══════════════════════════════════════════════════════════════════════════════
# Шаблон настроек для docker-compose. Скопируй его в файл `.env`:
#   cp .env.example .env
# Заполни значения и запусти:  docker compose up -d
# Файл `.env` уже в .gitignore — секреты в git не попадут.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Порт наружу (интерфейс: http://localhost:8000/canvas) ──
AGENT_CANVAS_PORT=8000

# ── Build-args для сборки образа (не трогай, если не знаешь зачем) ──
# Версии по умолчанию берутся из config/defaults.json; здесь они на тот случай,
# если захочешь переопределить или обновить agent-server.
# AGENT_SERVER_IMAGE=ghcr.io/openhands/agent-server:1.40.1-python
# AUTOMATION_VERSION=1.6.0
# VITE_BASE_PATH=/canvas

# ── Свой LLM-провайдер ──
# ВАЖНО: эти переменные задают значения по умолчанию для agent-server.
# Чтобы провайдер отображался и использовался в интерфейсе Canvas, дополнительно
# создай LLM-профиль: Settings → LLM settings → Add LLM Profile
# (Base URL + модель + ключ) → Set as active. Env-переменные НЕ наполняют
# выпадающие списки провайдеров в UI автоматически.
# Модель, например gpt-4o-mini или your-local-model
LLM_MODEL=
# Базовый URL OpenAI-совместимого endpoint.
# Если провайдер на хосте (Ollama/LM Studio) — используй host.docker.internal:
#   http://host.docker.internal:11434/v1
LLM_BASE_URL=
# Ключ (пусто, если провайдер без авторизации)
LLM_API_KEY=
# Версия API (для Azure), обычно не нужно
LLM_API_VERSION=
# Тип провайдера: openai, anthropic, azure, ollama, ... (по желанию)
LLM_PROVIDER=

# ── Vision для своих моделей ──
# Через запятую перечисли подстроки имён моделей, которые нужно считать
# vision-способными (когда LiteLLM/реестр их не знает). Пример:
#   OPENHANDS_VISION_MODELS=unsloth/gemma,my-vision-model
# Gemma-3 распознаётся как vision автоматически (см. VISION_MODEL_OVERRIDES),
# поэтому для Gemma-3 обычно ничего задавать не нужно. Для других локальных
# мультимодальных моделей (Qwen-VL, LLaVA и т.п.) укажи подстроку имени здесь.
OPENHANDS_VISION_MODELS=

# ── Прокси для внешних LLM-провайдеров и загрузки модулей (openhands.dev, GitHub) ──
# Единый переключатель «через прокси / напрямую» — стандартные переменные.
#   • Если HTTP_PROXY задан (напр. http://proxy.corp.example:3128) — весь
#     исходящий трафик (LLM, MCP, загрузка навыков/плагинов) идёт через него.
#   • Если пуст — прокси ОТКЛЮЧЁН, всё ходит напрямую.
HTTP_PROXY=
# Необязательно: отдельный https-прокси (по умолчанию = HTTP).
HTTPS_PROXY=
# Хосты в обход прокси (внутренние сервисы общаются через 127.0.0.1).
NO_PROXY=localhost,127.0.0.1

# ── Безопасность: задай свой ключ (openssl rand -base64 32). Если пусто —
#    сгенерируется автоматически и сохранится в томе. ──
LOCAL_BACKEND_API_KEY=

# ── Папка с проектами агента (монтируется в /projects) ──
# Это куда агент кладёт созданные файлы. Задай постоянную папку на хосте,
# чтобы файлы переживали пересборку контейнера. Пример для WSL:
#   PROJECTS_PATH=/mnt/d/workflow
PROJECTS_PATH=./projects

# ── Рабочая директория агента (где создаются файлы в новом диалоге) ──
# По умолчанию /projects (смонтированный каталог выше). Обычно не нужно менять.
# VITE_WORKING_DIR=/projects

# ── Ресурсы агента ──
# Одновременно выполняемые шаги агентов. Каждый запуск может использовать LLM,
# браузер и отдельный поток; 4 — сбалансированный и предсказуемый дефолт для
# одного инстанса. Увеличивай только вместе с CPU/RAM и лимитами провайдера.
OH_MAX_CONCURRENT_RUNS=4

# ── Интерактивный браузер (VNC) ──
# Включает VNC-сервер (TigerVNC + noVNC) внутри контейнера. Это позволяет
# просматривать и взаимодействовать с браузером агента в реальном времени
# во вкладке «Browser»: кликать, вводить текст, проходить капчу и т.д.
# Без этого доступна только статичная картинка (скриншот).
# Значения: true/false. По умолчанию true.
OH_ENABLE_VNC=true

# ── Надёжность браузера: защита от зависшего Chromium ──
# Разбор реального инцидента и устройство защиты: docs/BROWSER_STABILITY_RU.md
#
# Работают два независимых контура:
#   1) внутренний сторож в agent-server (убивает wedged-браузер и прозрачно
#      перезапускает сессию) — OH_BROWSER_GUARD*;
#   2) внешний сторож контейнера docker/browser-watchdog.py (добивает зависшие
#      и осиротевшие процессы Chromium, даже если agent-server мёртв) —
#      OH_BROWSER_WATCHDOG*.
#
# Внутренний сторож (0 — отключить соответствующую проверку):
OH_BROWSER_GUARD=1
# Период опроса /proc, сек
OH_BROWSER_GUARD_INTERVAL_SECONDS=10
# Процесс браузера жжёт >=N% одного ядра...
OH_BROWSER_GUARD_CPU_PERCENT=90
# ...непрерывно в течение N секунд...
OH_BROWSER_GUARD_CPU_SECONDS=180
# ...и при этом агент НЕ пользовался браузером N секунд → считаем зависшим.
# Пока агент активно работает, «горячий» браузер не убивается.
OH_BROWSER_GUARD_IDLE_GRACE_SECONDS=120
# Абсолютные бюджеты (срабатывают даже во время активной работы; 0 = выключить)
OH_BROWSER_GUARD_MAX_CPU_MINUTES=180
OH_BROWSER_GUARD_MAX_LIFETIME_MINUTES=360
OH_BROWSER_GUARD_MAX_RSS_MB=4096
# Пауза между SIGTERM и SIGKILL
OH_BROWSER_GUARD_KILL_GRACE_SECONDS=5
# Период фоновой зачистки осиротевших браузеров внутри сторожа (сек)
OH_BROWSER_GUARD_SWEEP_INTERVAL_SECONDS=300
# Понижать приоритет процессов браузера (nice +N). Главное средство от
# «CPU starvation»: даже зависший Chromium не отбирает процессор у
# agent-server, automation и телеграм-моста. 0 = не трогать приоритет.
OH_BROWSER_NICE_LEVEL=10
# Добивать осиротевшие браузеры от предыдущих запусков (при старте и при
# перезапуске agent-server). Трогаются только «автоматизационные» профили
# browser-use; браузер, открытый человеком в VNC, не затрагивается.
OH_BROWSER_SWEEP_ORPHANS=1
# Контейнерные флаги Chromium (--disable-gpu, --disable-dev-shm-usage, ...)
OH_BROWSER_HARDENED_ARGS=1
# Лимит процессов-рендеров (меньше вкладок-процессов = меньше CPU/RAM)
OH_BROWSER_RENDERER_LIMIT=4
# Свои флаги Chromium через пробел, например:
#   OH_BROWSER_EXTRA_ARGS=--proxy-server=http://127.0.0.1:3128
OH_BROWSER_EXTRA_ARGS=
# Расширения browser-use (uBlock, «I still don't care about cookies», ClearURLs)
# скачиваются при старте браузера БЕЗ таймаута и НЕ кэшируются в volume:
# в офлайне/за прокси это подвешивает запуск сессии на минуты. По умолчанию 0.
OH_BROWSER_DEFAULT_EXTENSIONS=0

# Внешний сторож контейнера (запускается из entrypoint.sh):
OH_BROWSER_WATCHDOG=1
OH_BROWSER_WATCHDOG_INTERVAL_SECONDS=20
OH_BROWSER_WATCHDOG_CPU_PERCENT=90
OH_BROWSER_WATCHDOG_CPU_SECONDS=600
OH_BROWSER_WATCHDOG_MAX_CPU_MINUTES=240
OH_BROWSER_WATCHDOG_MAX_AGE_MINUTES=720

# ── Супервизор сервисов (entrypoint.sh) ──
# Раньше контейнер считался живым, пока жив статический сервер: упавший
# agent-server никто не перезапускал, и интерфейс «висел» сутками.
# Теперь упавшие сервисы перезапускаются; после N падений подряд контейнер
# завершается, и Docker поднимает его заново (restart: unless-stopped).
OH_SERVICE_MAX_RESTARTS=5
OH_SUPERVISOR_INTERVAL=10
# Счётчик падений сбрасывается, если сервис проработал дольше N секунд
OH_SERVICE_STABLE_SECONDS=600

# ── Ресурсы контейнера (docker-compose) ──
# /dev/shm для Chromium: дефолт Docker 64 МБ — частая причина зависаний
# gpu/renderer процессов. 2 ГБ закрывают проблему.
OH_SHM_SIZE=2gb
# Размер tmpfs /tmp в продакшен-оверрайде (Chromium с --disable-dev-shm-usage
# использует /tmp под общую память):
OH_TMP_SIZE=1g
# Лимиты CPU/памяти (в продакшен-оверрайде). Значения по умолчанию выбраны так,
# чтобы на небольшом хосте фактически не срабатывать, а на мощном — не давать
# одному процессу съесть узел:
OH_CPU_LIMIT=8
OH_MEMORY_LIMIT=12g
OH_MEMORY_RESERVATION=1g
OH_PIDS_LIMIT=2048
OH_NOFILE_LIMIT=65536
OH_STOP_GRACE_PERIOD=45s

# ── Поведение телеграм-моста при сбоях связи ──
# Экспоненциальная задержка вместо спама «poll error: ETIMEDOUT» каждые 5 с:
TELEGRAM_POLL_BACKOFF_MIN_MS=3000
TELEGRAM_POLL_BACKOFF_MAX_MS=300000
# Как часто повторять одну и ту же ошибку в логе (напоминание), мс
TELEGRAM_POLL_ERROR_REMINDER_MS=900000

# ── Навыки/расширения (OpenHands/extensions) ──
# По умолчанию агент читает навыки из вендоренного каталога, зашитого в образ
# (/opt/agent-canvas/extensions), — без сети. Если хочешь свой источник:
#   • EXTENSIONS_REPO — путь к папке с навыками (локальный каталог в контейнере)
#     или git-URL для клонирования из сети.
#   • EXTENSIONS_MARKETPLACE — путь к маркетплейс-манифесту внутри каталога
#     (по умолчанию выбирается сам: openhands-extensions.json, иначе default.json).
# EXTENSIONS_REPO=/opt/agent-canvas/extensions
# EXTENSIONS_MARKETPLACE=marketplaces/openhands-extensions.json

# ── Уведомления: связь агента с внешним миром (навык notify) ──
# Заполни свои контакты ОДИН РАЗ — и агент сможет отправлять отчёты по фразе
# «отправь мне отчёт на почту / в телеграм» БЕЗ уточняющих вопросов.
# Подробная инструкция (пароли приложений, создание бота): docs/NOTIFICATIONS_RU.md
#
# Email (SMTP). Для Gmail/Yandex/Mail.ru нужен «пароль приложения», не обычный:
#   Gmail:   smtp.gmail.com : 587  (myaccount.google.com/apppasswords)
#   Yandex:  smtp.yandex.ru : 465  (id.yandex.ru → «Пароли приложений»)
#   Mail.ru: smtp.mail.ru   : 465  (account.mail.ru → «Пароли для внешних приложений»)
SMTP_HOST=
SMTP_PORT=465
# Ящик принадлежит АГЕНТУ (не владельцу). Для дежурного ящика лучше свой адрес
# (например agent@твой-домен.ru), а не личная почта.
SMTP_USER=
SMTP_PASSWORD=
# Адрес отправителя (по умолчанию = SMTP_USER)
SMTP_FROM=
#
# ── Синтезированный профиль агента ──
# Единое лицо агента: используется в From-заголовке, подписи писем и при
# регистрации на сайтах. Заполни один раз — агент будет представляться
# одинаково и не будет путать свою почту с почтой владельца.
AGENT_PROFILE_NAME=Ассистент AgentHaus
# Email агента для регистраций на сайтах (по умолчанию = SMTP_USER)
AGENT_PROFILE_EMAIL=
# Как агент представляется третьим лицам (роль/должность)
AGENT_PROFILE_ROLE=Автономный ассистент
# Подпись в конце исходящих писем; для перевода строки используй \n
AGENT_PROFILE_SIGNATURE=--\nАвтономный ассистент AgentHaus
#
# ТВОЙ email (владельца) — сюда агент шлёт отчёты по умолчанию
# («отправь мне на почту»). Это НЕ ящик агента — агент только отправляет на него.
NOTIFY_EMAIL_TO=
#
# Приём почты (IMAP) — чтобы агент читал письма и вёл переписку.
# Если SMTP_HOST имеет вид smtp.<домен> (например smtp.timeweb.ru), IMAP-хост
# выводится автоматически (imap.timeweb.ru:993 SSL) и здесь ничего задавать
# не нужно. Логин/пароль по умолчанию берутся из SMTP_USER/SMTP_PASSWORD.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Сохранять отправленные письма в папку «Отправленные» на сервере (IMAP APPEND).
# 1 или пусто = да (если настроен IMAP); 0 = нет. Папка ищется автоматически
# (по атрибуту \Sent), при нестандартном имени задай IMAP_SENT_FOLDER.
NOTIFY_SAVE_SENT=1
IMAP_SENT_FOLDER=
#
# Telegram: создай бота у @BotFather (/newbot → токен), напиши боту /start,
# затем узнай свой chat_id: https://api.telegram.org/bot<ТОКЕН>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
#
# Вебхук Slack / Discord / Mattermost (опционально)
NOTIFY_WEBHOOK_URL=

# ── Автоматизации (cron-задачи) ──
# Рубильник СОЗДАНИЯ новых автоматизаций. 1 = можно (по умолчанию);
# 0 = запрещено: агент/UI не смогут создать новую cron-задачу (403), но
# управлять существующими (пауза/запуск/удаление в Canvas → Автоматизации)
# по-прежнему можно. Удобно, чтобы старая задача не жгла токены незаметно.
AUTOMATION_ALLOW_CREATE=1

# ── GitHub App, опциональный режим PR-only ──
# Если переменные пусты, текущий git/PAT/SSH workflow работает без изменений.
# Создай GitHub App с Contents: Read/Write, Pull requests: Read/Write,
# Metadata: Read; установи только на разрешённые репозитории.
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# Не коммить private key. Предпочтителен путь к Docker secret внутри контейнера.
# GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github_app_private_key
# Для простого self-hosted запуска допустима PEM-строка с \n:
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ── Внешний URL автоматизаций (нужен только если публикуешь наружу) ──
# ПУБЛИЧНЫЙ URL для callback'ов/webhook'ов. Оставь пустым для локального
# запуска: внутри контейнера всё ходит на внутренний прокси автоматически.
# Хостовый порт (например :8300 при AGENT_CANVAS_PORT=8300) сюда писать НЕ
# нужно — изнутри контейнера он недоступен.
# AUTOMATION_BASE_URL=https://мой-домен.ру

# ── Админ-панель шлюза сервисов (/admin) ──
# Ключ администратора. Даёт доступ к /admin и к сервисам с access=admin.
# Передаётся заголовком  x-admin-key: <ключ>  или cookie  agenthaus_admin.
# Пока нет UI логина — это единственный способ войти в админку.
ADMIN_KEY=
