# ── Root ignores ───────────────────────────────────────────────────────────────
# Корневой docker-compose читает .env из корня. Не коммить его.
.env
.env.*
!.env.example

# Папка с проектами агента (монтируется в /projects). Данные, не исходники.
projects/

# Локальные данные сервисов/шлюза (RBAC-хранилище ./data/auth.json и т.п.).
data/
services/book-site/out/index.html
services/telegram-bridge/state.json
